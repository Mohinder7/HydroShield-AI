OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SNAP_GPT_PATH=

# ── GEE Random Forest model paths ─────────────────────────────────────────────
# Absolute path to the 6-band GEE feature raster (patna_s1_features_aug2026.tif).
# Download from Google Drive and set this before running /api/flood/predict.
# Leave blank to use the auto-search in EPICS--main/datasets/.
HYDROSHIELD_FEATURE_RASTER=

# Absolute path to the 1-band GEE candidate-mask raster
# (patna_flood_candidates_aug2026.tif). Required only for retraining with
# train_model.py. Leave blank to use the auto-search in EPICS--main/datasets/.
HYDROSHIELD_MASK_RASTER=

# Directory where prediction GeoTIFFs are written.
# Defaults to EPICS--main/outputs/predictions/ if not set.
HYDROSHIELD_OUTPUT_DIR=
